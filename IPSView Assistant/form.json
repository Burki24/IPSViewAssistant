{
    "actions": [
        {
            "type": "Label",
            "caption": "Create a new IPSView without using the technical IPSView creation dialog."
        },
        {
            "type": "ExpansionPanel",
            "caption": "View settings",
            "expanded": true,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "ValidationTextBox",
                            "name": "ViewName",
                            "caption": "View name",
                            "value": "Neue IPSView"
                        },
                        {
                            "type": "SelectCategory",
                            "name": "TargetCategoryID",
                            "caption": "Target category",
                            "value": 0
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "ValidationTextBox",
                            "name": "MainPageName",
                            "caption": "Main page name",
                            "value": "Hauptseite"
                        },
                        {
                            "type": "Select",
                            "name": "AspectRatio",
                            "caption": "Aspect ratio",
                            "value": 2,
                            "options": [
                                {
                                    "caption": "Square (1:1)",
                                    "value": 0
                                },
                                {
                                    "caption": "Classic (4:3)",
                                    "value": 1
                                },
                                {
                                    "caption": "Widescreen (16:9)",
                                    "value": 2
                                }
                            ]
                        },
                        {
                            "type": "Select",
                            "name": "Orientation",
                            "caption": "Orientation",
                            "value": 0,
                            "options": [
                                {
                                    "caption": "Landscape",
                                    "value": 0
                                },
                                {
                                    "caption": "Portrait",
                                    "value": 1
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "Select",
                    "name": "Template",
                    "caption": "Template",
                    "value": 0,
                    "options": [
                        {
                            "caption": "Empty View",
                            "value": 0
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Existing View",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Select an existing IPSView. Its design is loaded into the semantic color controls; the original is never changed."
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectMedia",
                            "name": "SourceViewID",
                            "caption": "Source IPSView",
                            "value": 0,
                            "width": "500px",
                            "onChange": "IPSVIEWA_LoadExistingView($id, $SourceViewID);"
                        },
                        {
                            "type": "ValidationTextBox",
                            "name": "CopyViewName",
                            "caption": "Copy name",
                            "value": "IPSView Designkopie",
                            "width": "420px"
                        },
                        {
                            "type": "SelectCategory",
                            "name": "CopyTargetCategoryID",
                            "caption": "Copy target category",
                            "value": 0,
                            "width": "420px"
                        }
                    ]
                },
                {
                    "type": "Select",
                    "name": "DesignScope",
                    "caption": "Design scope",
                    "value": 1,
                    "width": "500px",
                    "options": [
                        {
                            "caption": "Global defaults only (safest)",
                            "value": 0
                        },
                        {
                            "caption": "Theme matching control colors (recommended)",
                            "value": 1
                        },
                        {
                            "caption": "All basic control colors (strong)",
                            "value": 2
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "The recommended scope updates control colors only when they match an existing global design color. The strong scope also standardizes basic backgrounds, text and borders; association and special status colors remain protected unless they match a semantic global color."
                },
                {
                    "type": "Label",
                    "name": "ExistingViewStatus",
                    "caption": "No existing IPSView has been loaded yet."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Design",
            "expanded": true,
            "items": [
                {
                    "type": "Select",
                    "name": "Theme",
                    "caption": "Theme",
                    "value": 0,
                    "onChange": "IPSVIEWA_ApplyThemePreset($id, $Theme, json_encode([\"viewBackground\" => $ViewBackgroundColor, \"pageBackground\" => $PageBackgroundColor, \"surface\" => $SurfaceColor, \"primaryText\" => $PrimaryTextColor, \"secondaryText\" => $SecondaryTextColor, \"border\" => $BorderColor, \"accent\" => $AccentColor, \"active\" => $ActiveColor, \"inactive\" => $InactiveColor, \"success\" => $SuccessColor, \"warning\" => $WarningColor, \"error\" => $ErrorColor], JSON_UNESCAPED_SLASHES));",
                    "options": [
                        {
                            "caption": "IPSView Standard",
                            "value": 0
                        },
                        {
                            "caption": "Light",
                            "value": 1
                        },
                        {
                            "caption": "Dark",
                            "value": 2
                        },
                        {
                            "caption": "Custom",
                            "value": 3
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "Choose a preset or adjust the semantic colors below. A manual color change automatically switches the theme to Custom."
                },
                {
                    "type": "RowLayout",
                    "name": "ThemeWorkspace",
                    "items": [
                        {
                            "type": "ExpansionPanel",
                            "caption": "Design colors",
                            "expanded": true,
                            "items": [
                                {
                                    "type": "RowLayout",
                                    "items": [
                                        {
                                            "type": "SelectColor",
                                            "name": "ViewBackgroundColor",
                                            "caption": "View background",
                                            "value": 4210752,
                                            "allowTransparent": false,
                                            "width": "360px",
                                            "onChange": "IPSVIEWA_UpdateThemePreview($id, json_encode([\"viewBackground\" => $ViewBackgroundColor, \"pageBackground\" => $PageBackgroundColor, \"surface\" => $SurfaceColor, \"primaryText\" => $PrimaryTextColor, \"secondaryText\" => $SecondaryTextColor, \"border\" => $BorderColor, \"accent\" => $AccentColor, \"active\" => $ActiveColor, \"inactive\" => $InactiveColor, \"success\" => $SuccessColor, \"warning\" => $WarningColor, \"error\" => $ErrorColor], JSON_UNESCAPED_SLASHES));"
                                        },
                                        {
                                            "type": "SelectColor",
                                            "name": "PageBackgroundColor",
                                            "caption": "Page background",
                                            "value": 4210752,
                                            "allowTransparent": false,
                                            "width": "360px",
                                            "onChange": "IPSVIEWA_UpdateThemePreview($id, json_encode([\"viewBackground\" => $ViewBackgroundColor, \"pageBackground\" => $PageBackgroundColor, \"surface\" => $SurfaceColor, \"primaryText\" => $PrimaryTextColor, \"secondaryText\" => $SecondaryTextColor, \"border\" => $BorderColor, \"accent\" => $AccentColor, \"active\" => $ActiveColor, \"inactive\" => $InactiveColor, \"success\" => $SuccessColor, \"warning\" => $WarningColor, \"error\" => $ErrorColor], JSON_UNESCAPED_SLASHES));"
                                        }
                                    ]
                                },
                                {
                                    "type": "RowLayout",
                                    "items": [
                                        {
                                            "type": "SelectColor",
                                            "name": "SurfaceColor",
                                            "caption": "Cards and controls",
                                            "value": 6316128,
                                            "allowTransparent": false,
                                            "width": "360px",
                                            "onChange": "IPSVIEWA_UpdateThemePreview($id, json_encode([\"viewBackground\" => $ViewBackgroundColor, \"pageBackground\" => $PageBackgroundColor, \"surface\" => $SurfaceColor, \"primaryText\" => $PrimaryTextColor, \"secondaryText\" => $SecondaryTextColor, \"border\" => $BorderColor, \"accent\" => $AccentColor, \"active\" => $ActiveColor, \"inactive\" => $InactiveColor, \"success\" => $SuccessColor, \"warning\" => $WarningColor, \"error\" => $ErrorColor], JSON_UNESCAPED_SLASHES));"
                                        },
                                        {
                                            "type": "SelectColor",
                                            "name": "PrimaryTextColor",
                                            "caption": "Primary text",
                                            "value": 16777215,
                                            "allowTransparent": false,
                                            "width": "360px",
                                            "onChange": "IPSVIEWA_UpdateThemePreview($id, json_encode([\"viewBackground\" => $ViewBackgroundColor, \"pageBackground\" => $PageBackgroundColor, \"surface\" => $SurfaceColor, \"primaryText\" => $PrimaryTextColor, \"secondaryText\" => $SecondaryTextColor, \"border\" => $BorderColor, \"accent\" => $AccentColor, \"active\" => $ActiveColor, \"inactive\" => $InactiveColor, \"success\" => $SuccessColor, \"warning\" => $WarningColor, \"error\" => $ErrorColor], JSON_UNESCAPED_SLASHES));"
                                        }
                                    ]
                                },
                                {
                                    "type": "RowLayout",
                                    "items": [
                                        {
                                            "type": "SelectColor",
                                            "name": "SecondaryTextColor",
                                            "caption": "Secondary text",
                                            "value": 10790052,
                                            "allowTransparent": false,
                                            "width": "360px",
                                            "onChange": "IPSVIEWA_UpdateThemePreview($id, json_encode([\"viewBackground\" => $ViewBackgroundColor, \"pageBackground\" => $PageBackgroundColor, \"surface\" => $SurfaceColor, \"primaryText\" => $PrimaryTextColor, \"secondaryText\" => $SecondaryTextColor, \"border\" => $BorderColor, \"accent\" => $AccentColor, \"active\" => $ActiveColor, \"inactive\" => $InactiveColor, \"success\" => $SuccessColor, \"warning\" => $WarningColor, \"error\" => $ErrorColor], JSON_UNESCAPED_SLASHES));"
                                        },
                                        {
                                            "type": "SelectColor",
                                            "name": "BorderColor",
                                            "caption": "Borders and separators",
                                            "value": 8355711,
                                            "allowTransparent": false,
                                            "width": "360px",
                                            "onChange": "IPSVIEWA_UpdateThemePreview($id, json_encode([\"viewBackground\" => $ViewBackgroundColor, \"pageBackground\" => $PageBackgroundColor, \"surface\" => $SurfaceColor, \"primaryText\" => $PrimaryTextColor, \"secondaryText\" => $SecondaryTextColor, \"border\" => $BorderColor, \"accent\" => $AccentColor, \"active\" => $ActiveColor, \"inactive\" => $InactiveColor, \"success\" => $SuccessColor, \"warning\" => $WarningColor, \"error\" => $ErrorColor], JSON_UNESCAPED_SLASHES));"
                                        }
                                    ]
                                },
                                {
                                    "type": "RowLayout",
                                    "items": [
                                        {
                                            "type": "SelectColor",
                                            "name": "AccentColor",
                                            "caption": "Accent",
                                            "value": 31487,
                                            "allowTransparent": false,
                                            "width": "360px",
                                            "onChange": "IPSVIEWA_UpdateThemePreview($id, json_encode([\"viewBackground\" => $ViewBackgroundColor, \"pageBackground\" => $PageBackgroundColor, \"surface\" => $SurfaceColor, \"primaryText\" => $PrimaryTextColor, \"secondaryText\" => $SecondaryTextColor, \"border\" => $BorderColor, \"accent\" => $AccentColor, \"active\" => $ActiveColor, \"inactive\" => $InactiveColor, \"success\" => $SuccessColor, \"warning\" => $WarningColor, \"error\" => $ErrorColor], JSON_UNESCAPED_SLASHES));"
                                        },
                                        {
                                            "type": "SelectColor",
                                            "name": "ActiveColor",
                                            "caption": "Active",
                                            "value": 704010,
                                            "allowTransparent": false,
                                            "width": "360px",
                                            "onChange": "IPSVIEWA_UpdateThemePreview($id, json_encode([\"viewBackground\" => $ViewBackgroundColor, \"pageBackground\" => $PageBackgroundColor, \"surface\" => $SurfaceColor, \"primaryText\" => $PrimaryTextColor, \"secondaryText\" => $SecondaryTextColor, \"border\" => $BorderColor, \"accent\" => $AccentColor, \"active\" => $ActiveColor, \"inactive\" => $InactiveColor, \"success\" => $SuccessColor, \"warning\" => $WarningColor, \"error\" => $ErrorColor], JSON_UNESCAPED_SLASHES));"
                                        }
                                    ]
                                },
                                {
                                    "type": "RowLayout",
                                    "items": [
                                        {
                                            "type": "SelectColor",
                                            "name": "InactiveColor",
                                            "caption": "Inactive",
                                            "value": 12454410,
                                            "allowTransparent": false,
                                            "width": "360px",
                                            "onChange": "IPSVIEWA_UpdateThemePreview($id, json_encode([\"viewBackground\" => $ViewBackgroundColor, \"pageBackground\" => $PageBackgroundColor, \"surface\" => $SurfaceColor, \"primaryText\" => $PrimaryTextColor, \"secondaryText\" => $SecondaryTextColor, \"border\" => $BorderColor, \"accent\" => $AccentColor, \"active\" => $ActiveColor, \"inactive\" => $InactiveColor, \"success\" => $SuccessColor, \"warning\" => $WarningColor, \"error\" => $ErrorColor], JSON_UNESCAPED_SLASHES));"
                                        },
                                        {
                                            "type": "SelectColor",
                                            "name": "SuccessColor",
                                            "caption": "Success",
                                            "value": 704010,
                                            "allowTransparent": false,
                                            "width": "360px",
                                            "onChange": "IPSVIEWA_UpdateThemePreview($id, json_encode([\"viewBackground\" => $ViewBackgroundColor, \"pageBackground\" => $PageBackgroundColor, \"surface\" => $SurfaceColor, \"primaryText\" => $PrimaryTextColor, \"secondaryText\" => $SecondaryTextColor, \"border\" => $BorderColor, \"accent\" => $AccentColor, \"active\" => $ActiveColor, \"inactive\" => $InactiveColor, \"success\" => $SuccessColor, \"warning\" => $WarningColor, \"error\" => $ErrorColor], JSON_UNESCAPED_SLASHES));"
                                        }
                                    ]
                                },
                                {
                                    "type": "RowLayout",
                                    "items": [
                                        {
                                            "type": "SelectColor",
                                            "name": "WarningColor",
                                            "caption": "Warning",
                                            "value": 16711680,
                                            "allowTransparent": false,
                                            "width": "360px",
                                            "onChange": "IPSVIEWA_UpdateThemePreview($id, json_encode([\"viewBackground\" => $ViewBackgroundColor, \"pageBackground\" => $PageBackgroundColor, \"surface\" => $SurfaceColor, \"primaryText\" => $PrimaryTextColor, \"secondaryText\" => $SecondaryTextColor, \"border\" => $BorderColor, \"accent\" => $AccentColor, \"active\" => $ActiveColor, \"inactive\" => $InactiveColor, \"success\" => $SuccessColor, \"warning\" => $WarningColor, \"error\" => $ErrorColor], JSON_UNESCAPED_SLASHES));"
                                        },
                                        {
                                            "type": "SelectColor",
                                            "name": "ErrorColor",
                                            "caption": "Error",
                                            "value": 12454410,
                                            "allowTransparent": false,
                                            "width": "360px",
                                            "onChange": "IPSVIEWA_UpdateThemePreview($id, json_encode([\"viewBackground\" => $ViewBackgroundColor, \"pageBackground\" => $PageBackgroundColor, \"surface\" => $SurfaceColor, \"primaryText\" => $PrimaryTextColor, \"secondaryText\" => $SecondaryTextColor, \"border\" => $BorderColor, \"accent\" => $AccentColor, \"active\" => $ActiveColor, \"inactive\" => $InactiveColor, \"success\" => $SuccessColor, \"warning\" => $WarningColor, \"error\" => $ErrorColor], JSON_UNESCAPED_SLASHES));"
                                        }
                                    ]
                                }
                            ],
                            "name": "ThemeColorsPanel",
                            "width": "820px"
                        },
                        {
                            "type": "ExpansionPanel",
                            "name": "ThemePreviewPanel",
                            "caption": "Preview",
                            "expanded": true,
                            "width": "700px",
                            "items": [
                                {
                                    "type": "Image",
                                    "name": "ThemePreview",
                                    "image": "",
                                    "center": true,
                                    "width": "100%"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Button",
                    "caption": "Create View",
                    "onClick": "echo IPSVIEWA_CreateView($id, $ViewName, $TargetCategoryID, $AspectRatio, $Orientation, $Template, $MainPageName, $Theme, json_encode([\"viewBackground\" => $ViewBackgroundColor, \"pageBackground\" => $PageBackgroundColor, \"surface\" => $SurfaceColor, \"primaryText\" => $PrimaryTextColor, \"secondaryText\" => $SecondaryTextColor, \"border\" => $BorderColor, \"accent\" => $AccentColor, \"active\" => $ActiveColor, \"inactive\" => $InactiveColor, \"success\" => $SuccessColor, \"warning\" => $WarningColor, \"error\" => $ErrorColor], JSON_UNESCAPED_SLASHES));"
                },
                {
                    "type": "Button",
                    "caption": "Save styled copy",
                    "onClick": "echo IPSVIEWA_CreateStyledCopy($id, $SourceViewID, $CopyViewName, $CopyTargetCategoryID, $Theme, json_encode([\"viewBackground\" => $ViewBackgroundColor, \"pageBackground\" => $PageBackgroundColor, \"surface\" => $SurfaceColor, \"primaryText\" => $PrimaryTextColor, \"secondaryText\" => $SecondaryTextColor, \"border\" => $BorderColor, \"accent\" => $AccentColor, \"active\" => $ActiveColor, \"inactive\" => $InactiveColor, \"success\" => $SuccessColor, \"warning\" => $WarningColor, \"error\" => $ErrorColor], JSON_UNESCAPED_SLASHES), $DesignScope);",
                    "name": "SaveStyledCopyButton"
                }
            ]
        },
        {
            "type": "Label",
            "caption": "The first save creates a separate design copy. Further saves with the same name and target category update that copy while preserving all later IPSView Designer changes."
        },
        {
            "type": "Label",
            "caption": "After creation, open the new media object in the object tree and save it once in the IPSView Designer."
        }
    ],
    "status": []
}
